{
  "name": "polymarket-5m-signal-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Webhook-driven $3.25 FOK bets on Polymarket 5-minute Bitcoin Up/Down markets",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts serve",
    "start": "node dist/index.js serve",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "doctor": "tsx src/index.ts doctor",
    "simulate": "tsx src/index.ts simulate",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@polymarket/client": "0.14.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "pino": "^9.13.0",
    "viem": "^2.46.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
